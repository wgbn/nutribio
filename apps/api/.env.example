# @nutribio/api — environment example (documentation only; copy to `.env`).
#
# `.env` is gitignored. Production secrets live in the API host's environment
# (phase 4.8). Never commit real values.

# --- Local Supabase stack (npm run db:start -w @nutribio/db) -----------------
# Values printed by `npm run db:status -w @nutribio/db` (API URL + secret key).
NUXT_SUPABASE_URL="http://127.0.0.1:54321"
NUXT_SUPABASE_SECRET_KEY=""

# The API connects with its own `nutribio_api` role (bypassrls), never with the
# postgres superuser. Locally the stack's `postgres` URL is fine:
NUXT_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Production (session pooler, IPv6-free):
# NUXT_DATABASE_URL="postgresql://nutribio_api.<ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

# --- CORS --------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API.
NUXT_CORS_ORIGINS="http://localhost:5173,https://nbio.loca.lt,https://wgbn.github.io"
