# @nutribio/db — environment example (documentation only; copy to `.env`).
#
# `.env` is gitignored. Never commit real values; the production secrets live
# in the API host's environment (phase 4.8), not in this file.

# --- Local Supabase stack (npm run db:start -w @nutribio/db) -----------------
# Values printed by `npm run db:status -w @nutribio/db`.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Google OAuth is DEFERRED to the end of the project (DECISIONS #42): v1 signs
# in with email + password + 6-digit OTP only, and the provider is disabled in
# config.toml. Fill these two variables (and flip `enabled = true`) only when
# SSO is added. Redirect URI to register in Google Cloud:
#   http://127.0.0.1:54321/auth/v1/callback (local)
#   https://<project-ref>.supabase.co/auth/v1/callback (production)
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=""
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=""

# --- Hosted project (production, DECISIONS #38) -----------------------------
# `db.<ref>.supabase.co` is IPv6-only on the Free plan, so the API (phase 4.4)
# connects through the session pooler with its own role:
#   postgresql://nutribio_api.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# `NUTRIBIO_API_DATABASE_URL` holds that URL (generated once, gitignored).
# SUPABASE_PROJECT_REF=""
# NUTRIBIO_API_DATABASE_URL=""
